# Copy to .env.test. The tenant isolation test signs up throwaway users here
# using only the publishable key, so email confirmation must be off on this
# project. Never put the service role key in this file.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
# Optional: domain for generated test emails (default example.com).
SUPABASE_TEST_EMAIL_DOMAIN=
