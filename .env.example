NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. The source repository's URL; the landing page links to it only
# when this is set, so leave it empty while the repository is private.
NEXT_PUBLIC_REPO_URL=
# Extraction. Server only: never NEXT_PUBLIC_. At least the primary
# provider's key is required; the other is the fallback if its key is set.
EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
